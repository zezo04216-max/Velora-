rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'zezo04216@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function profile() { return get(/databases/$(database)/documents/users/$(uid())).data; }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(uid())); }
    function roleIs(r) { return signedIn() && hasProfile() && profile().role == r; }
    function isStr(v, max) { return v is string && v.size() <= max; }

    match /{document=**} { allow read, write: if false; }

    // ---- users ----
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && uid() == userId);
      allow create: if signedIn() && uid() == userId
        && request.resource.data.id == userId
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(['id','name','email','phone','role','status','avatarUrl','city','bio','createdAt'])
        && isStr(request.resource.data.name, 120)
        && (request.resource.data.role in ['client','venue_owner','photographer','service_provider']
            || (request.resource.data.role == 'admin' && isAdmin()));
      allow update: if isAdmin()
        || (signedIn() && uid() == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','city','bio','avatarUrl','email','role'])
            && (request.resource.data.role == resource.data.role
                || (request.resource.data.role == 'admin' && isAdmin())));
      allow delete: if false;
    }

    // ---- listings: venues / photographers / services ----
    match /venues/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (signedIn() && resource.data.ownerId == uid());
      allow create: if signedIn() && request.resource.data.ownerId == uid()
        && (roleIs('venue_owner') || isAdmin())
        && (isAdmin() || (request.resource.data.status == 'pending' && request.resource.data.featured == false))
        && request.resource.data.avgRating == 0 && request.resource.data.reviewsCount == 0;
      allow update, delete: if isAdmin();
    }
    match /photographers/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (signedIn() && resource.data.ownerId == uid());
      allow create: if signedIn() && request.resource.data.ownerId == uid()
        && (roleIs('photographer') || isAdmin())
        && (isAdmin() || (request.resource.data.status == 'pending' && request.resource.data.featured == false))
        && request.resource.data.avgRating == 0 && request.resource.data.reviewsCount == 0;
      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['albums']));
      allow delete: if isAdmin();
    }
    match /services/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (signedIn() && resource.data.ownerId == uid());
      allow create: if signedIn() && request.resource.data.ownerId == uid()
        && (roleIs('service_provider') || isAdmin())
        && (isAdmin() || (request.resource.data.status == 'pending' && request.resource.data.featured == false))
        && request.resource.data.avgRating == 0 && request.resource.data.reviewsCount == 0;
      allow update, delete: if isAdmin();
    }

    // ---- customer requests (only signed-in providers and admin see all; clients see their own) ----
    match /requests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.clientId == uid())
        || (signedIn() && hasProfile() && profile().role in ['venue_owner','photographer','service_provider']);
      allow create: if signedIn() && request.resource.data.clientId == uid() && request.resource.data.status == 'open';
      allow update, delete: if isAdmin();
      match /private/{docId} {
        allow read: if isAdmin() || (signedIn() && resource.data.clientId == uid());
        allow create: if signedIn() && request.resource.data.clientId == uid()
          && get(/databases/$(database)/documents/requests/$(id)).data.clientId == uid();
        allow update, delete: if isAdmin();
      }
      // Provider offers/replies to a customer request. Doc id = provider uid (one reply each).
      match /replies/{rid} {
        allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.clientId == uid() || resource.data.providerId == uid()));
        allow create: if signedIn() && rid == uid()
          && request.resource.data.providerId == uid()
          && hasProfile() && profile().role in ['venue_owner','photographer','service_provider']
          && request.resource.data.clientId == get(/databases/$(database)/documents/requests/$(id)).data.clientId
          && request.resource.data.clientId != uid()
          && get(/databases/$(database)/documents/requests/$(id)).data.status == 'open'
          && request.resource.data.status == 'sent'
          && request.resource.data.priceEgp is int && request.resource.data.priceEgp >= 0 && request.resource.data.priceEgp <= 10000000
          && isStr(request.resource.data.noteAr, 600);
        allow update: if signedIn() && (
          (resource.data.clientId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
            && request.resource.data.status in ['accepted','ignored'])
          || (resource.data.providerId == uid() && resource.data.status == 'sent'
            && request.resource.data.status == 'sent'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['priceEgp','noteAr','serviceId','serviceTitle','providerPhone','updatedAt'])
            && request.resource.data.priceEgp is int && request.resource.data.priceEgp >= 0 && request.resource.data.priceEgp <= 10000000
            && isStr(request.resource.data.noteAr, 600))
        ) || isAdmin();
        allow delete: if isAdmin() || (signedIn() && resource.data.providerId == uid() && resource.data.status == 'sent');
      }
    }

    // ---- bookings ----
    match /bookings/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.clientId == uid() || resource.data.providerOwnerId == uid()));
      allow create: if signedIn() && request.resource.data.clientId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.providerApproved == false && request.resource.data.adminApproved == false;
      allow update: if isAdmin()
        || (signedIn() && resource.data.providerOwnerId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['providerApproved','providerNote','status','updatedAt'])
            && request.resource.data.adminApproved == resource.data.adminApproved)
        || (signedIn() && resource.data.clientId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
            && request.resource.data.status == 'cancelled');
      allow delete: if false;
    }
    // Public date-hold markers so everyone can see which dates are taken.
    match /slots/{id} {
      allow read: if true;
      allow create: if signedIn() && (isAdmin()
        || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerOwnerId == uid());
      allow delete: if signedIn() && (isAdmin()
        || get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.providerOwnerId == uid()
        || get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.clientId == uid());
      allow update: if false;
    }

    // ---- reviews ----
    match /reviews/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (signedIn() && resource.data.authorId == uid());
      allow create: if signedIn() && request.resource.data.authorId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && isStr(request.resource.data.commentAr, 1000);
      allow update, delete: if isAdmin();
    }

    // ---- favorites ----
    match /favorites/{id} {
      allow read, delete: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && request.resource.data.userId == uid() && id.matches('^' + uid() + '_.*');
      allow update: if false;
    }

    // ---- notifications ----
    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.userId == uid() || (resource.data.userId == 'admin' && isAdmin()));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id','userId','titleAr','bodyAr','kind','relatedRoute','isRead','createdAt'])
        && request.resource.data.isRead == false
        && isStr(request.resource.data.titleAr, 200) && isStr(request.resource.data.bodyAr, 1000);
      allow update: if signedIn() && (resource.data.userId == uid() || (resource.data.userId == 'admin' && isAdmin()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // ---- invitations (guest links are public by slug; lists are private) ----
    match /invitations/{slug} {
      allow get: if resource == null || resource.data.get('paymentStatus', 'free') != 'pending'
        || isAdmin() || (signedIn() && resource.data.ownerId == uid());
      allow list: if isAdmin() || (signedIn() && resource.data.ownerId == uid());
      // The price is taken from the admin-controlled config, never from the client.
      allow create: if signedIn() && request.resource.data.ownerId == uid() && request.resource.data.slug == slug
        && request.resource.data.designPriceEgp == get(/databases/$(database)/documents/config/invitationPricing).data.templatePrices[request.resource.data.designId]
        && ((request.resource.data.designPriceEgp > 0 && request.resource.data.paymentStatus == 'pending')
            || (request.resource.data.designPriceEgp == 0 && request.resource.data.paymentStatus == 'free'));
      // Only the admin can mark a paid card as activated.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus'])
        && request.resource.data.paymentStatus == 'paid';
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());

      // Voice/music for the guest page: base64 chunks, only the owner writes.
      match /audio/{n} {
        allow read: if get(/databases/$(database)/documents/invitations/$(slug)).data.get('paymentStatus', 'free') != 'pending'
          || isAdmin() || (signedIn() && get(/databases/$(database)/documents/invitations/$(slug)).data.ownerId == uid());
        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/invitations/$(slug)).data.ownerId == uid()
          && n in ['0','1','2','3']
          && request.resource.data.keys().hasOnly(['i','total','mime','name','data'])
          && request.resource.data.i is int && request.resource.data.total is int
          && request.resource.data.mime is string && request.resource.data.mime.matches('^audio/.*')
          && isStr(request.resource.data.name, 80)
          && isStr(request.resource.data.data, 900000);
        allow delete: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/invitations/$(slug)).data.ownerId == uid());
      }

      match /rsvps/{rid} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/invitations/$(slug))
          && request.resource.data.keys().hasOnly(['id','invitationId','guestName','guestPhone','response','companionsCount','congratulationMessage','createdAt'])
          && isStr(request.resource.data.guestName, 120) && request.resource.data.guestName.size() > 0
          && request.resource.data.response in ['attending','declined']
          && request.resource.data.companionsCount is int && request.resource.data.companionsCount >= 1 && request.resource.data.companionsCount <= 20
          && isStr(request.resource.data.congratulationMessage, 500)
          && request.resource.data.guestPhone == '';
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/invitations/$(slug)).data.ownerId == uid());
      }
      match /rsvp_private/{rid} {
        allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/invitations/$(slug)).data.ownerId == uid());
        allow create: if exists(/databases/$(database)/documents/invitations/$(slug))
          && request.resource.data.keys().hasOnly(['guestPhone']) && isStr(request.resource.data.guestPhone, 30);
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/invitations/$(slug)).data.ownerId == uid());
      }
    }

    // ---- couple workspace ----
    match /workspaces/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ---- config + audit ----
    // ---- subscription plans (public prices, admin edits) and requests ----
    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /subscriptions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow create: if signedIn() && request.resource.data.userId == uid()
        && get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.active == true
        && request.resource.data.amountEgp == (
             request.resource.data.billingCycle == 'annual'
               ? get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.annualPriceEgp
               : (request.resource.data.billingCycle == 'quarterly'
                   ? get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.quarterlyPriceEgp
                   : get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.monthlyPriceEgp))
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'active' && request.resource.data.amountEgp == 0
                && request.resource.data.planId == 'plan-client-free'));
      allow update, delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /auditLogs/{id} {
      allow read, create: if isAdmin();
    }
  }
}
