# VELORA_ADMIN_PASSCODE: Optional passcode for claiming or unlocking Admin access in production deployments.
# When the database has zero admin users, setting this requires matching the passcode on first-run admin setup.
VELORA_ADMIN_PASSCODE=""

# APP_URL: Public URL where the VÉLORA platform is hosted (used when sharing invitation links externally).
APP_URL="http://localhost:3000"

# --- Automated WhatsApp Wedding Reminders (Server-Side Only) ---
# WHATSAPP_PROVIDER: 'meta' | 'twilio' | 'ultramsg' (leave empty to run in safe local simulation mode)
WHATSAPP_PROVIDER=""

# Meta WhatsApp Cloud API (when WHATSAPP_PROVIDER=meta)
WHATSAPP_META_TOKEN=""
WHATSAPP_META_PHONE_ID=""
WHATSAPP_META_TEMPLATE=""
WHATSAPP_META_LANG="ar"

# Twilio WhatsApp (when WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# UltraMsg WhatsApp Gateway (when WHATSAPP_PROVIDER=ultramsg)
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""

# Secret header ('x-cron-secret' or 'Authorization: Bearer <secret>') for external cron triggers on POST /api/reminders/run
REMINDER_CRON_SECRET=""

