{
  "entities": {
    "UserAuthRecord": {
      "title": "UserAuthRecord",
      "description": "Authenticated user identity synchronized from Google / Firebase Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name.",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Gmail / email address.",
          "maxLength": 180
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional profile avatar URL.",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when record was last updated."
        }
      },
      "required": ["uid", "displayName", "email", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAuthRecord"
      },
      "description": "Private user authentication metadata isolated strictly to its verified owner."
    }
  }
}
